{
    "name": "nvl/mail-notification-bridge",
    "description": "Laravel consumer bridge for the Mail Notifications delivery API, Mailables, notifications, scoped history and signed callbacks.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "mail",
        "notifications",
        "api-client"
    ],
    "require": {
        "ext-filter": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "laravel/framework": "^13.0",
        "nvl/core": "^7.0",
        "php": "^8.4",
        "symfony/http-foundation": "^7.4.23 || ^8.1.11",
        "symfony/mailer": "^8.0",
        "symfony/mime": "^8.1.10"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Nvl\\MailNotificationBridge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nvl\\MailNotificationBridge\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nvl\\MailNotificationBridge\\Providers\\MailNotificationsServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "7.x-dev"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=2G",
        "format": "pint --parallel --format agent",
        "format:test": "pint --parallel --test --format agent",
        "quality": [
            "@format:test",
            "@analyse",
            "@test"
        ],
        "test": "pest --compact"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "archive": {
        "exclude": [
            "/.env*",
            "/.git*",
            "/.phpunit*",
            "/auth.json",
            "/build-release.php",
            "/composer.lock",
            "/phpunit.xml*",
            "/tests",
            "/vendor",
            "/.temp",
            "/phpstan.neon*"
        ]
    },
    "authors": [
        {
            "name": "Nicolas Vlachos",
            "homepage": "https://github.com/nicolasvlachos",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/nvl-laravel-suite/mail-notification-bridge",
    "support": {
        "source": "https://github.com/nvl-laravel-suite/mail-notification-bridge",
        "docs": "https://github.com/nvl-laravel-suite/mail-notification-bridge#readme",
        "issues": "https://github.com/nvl-laravel-suite/mail-notification-bridge/issues",
        "security": "https://github.com/nvl-laravel-suite/mail-notification-bridge/security/policy"
    }
}
